  "cards": [
    {
      "dot": "cyan",
      "title": "Training loop",
      "items": [
        "The runner gathers environment transitions into the buffer, then updates the actor and critic with PPO.",
        "Each environment step returns local observations, global state, shared reward, and episode status."
      ]
    },
    {
      "dot": "violet",
      "title": "CTDE contract",
      "items": [
        "Actors select actions from local observations; the centralized critic estimates values from global state.",
        "The saved checkpoint contains actor dimensions and weights, not critic or optimizer state."
      ]
    },
    {
      "dot": "amber",
      "title": "Scope and measurements",
      "items": [
        "This repository runs a small grid-world; it has no Isaac Sim adapter or simulator event feed.",
        "Timing tools use caller-supplied data; the actor latency benchmark is not a simulator benchmark."
      ]
    }
  ]
